# ── LLM Provider Configuration ─────────────────────────────────────
# Provider options: gemini | openai | anthropic | groq | local (Ollama/LM Studio/vLLM)
LLM_PROVIDER=gemini

# Model name:
#   For gemini    : gemini-3.1-flash-lite (default) | gemini-1.5-pro | gemini-1.5-flash
#   For openai    : gpt-4o-mini | gpt-4o | o1-mini
#   For anthropic : claude-3-5-sonnet-20241022 | claude-3-5-haiku-20241022
#   For groq      : llama-3.3-70b-versatile | mixtral-8x7b-32768
#   For local     : llama3.2 | mistral | deepseek-r1 | qwen2.5 (from Ollama/LM Studio)
LLM_MODEL=gemini-3.1-flash-lite

# API Keys (set the key for your active provider)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Local LLM URL (for Ollama, LM Studio, or vLLM when LLM_PROVIDER=local)
LOCAL_LLM_URL=http://localhost:11434/v1

# ── Security & Authentication ─────────────────────────────────────
# Any long random string — used to sign JWT tokens
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# ── Telegram Bot (optional) ───────────────────────────────────────
# Get from @BotFather on Telegram → /newbot
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ── Server config ─────────────────────────────────────────────────
PORT=8000
DB_PATH=aurora.db

# ── MLflow experiment tracking ────────────────────────────────────
# Local file storage (default). For remote: http://your-mlflow-server:5001
MLFLOW_TRACKING_URI=mlruns

# ── Obsidian KG sync (scripts/sync_to_obsidian.py only) ──────────
# Base URL of the running Aurora API
AURORA_API_BASE=http://localhost:8000/api
# Your Aurora account credentials for the sync script
AURORA_USERNAME=your_username_here
AURORA_PASSWORD=your_password_here

# ================================================================
# Aurora — .gitignore
# Place this file in the root of your project (aurora-final/)
# ================================================================

# ── Secrets — NEVER commit these ────────────────────────────────
.env
*.env
.env.local
.env.production
secrets.json

# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.so
pip-log.txt
pip-delete-this-directory.txt

# ── Virtual environments ─────────────────────────────────────────
venv/
env/
ENV/
.venv/
.env/
aurora-env/

# ── Database files ───────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
aurora.db
checkpoints.db
*.db-shm
*.db-wal

# ── Obsidian vault (generated by scripts/sync_to_obsidian.py) ────
obsidian-KG-vault/

# ── MLflow experiment data ───────────────────────────────────────
mlruns/
mlartifacts/
test_mlflow.db

# ── Testing ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.log
test_*.db

# ── Android / Buildozer ──────────────────────────────────────────
# Build output — APK files (large, re-buildable)
bin/
# Buildozer cache — downloads Android SDK (~2GB), don't commit
.buildozer/
# Android Studio files
*.apk
*.aab
*.keystore
local.properties
.gradle/
.idea/
*.iml

# ── Kivy ────────────────────────────────────────────────────────
*.kv~
.kivy/

# ── macOS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V3
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ── VS Code ─────────────────────────────────────────────────────
.vscode/
*.code-workspace
.history/

# ── PyCharm / JetBrains ─────────────────────────────────────────
.idea/
*.iws
*.ipr
out/

# ── Jupyter Notebooks ───────────────────────────────────────────
.ipynb_checkpoints
*.ipynb

# ── Logs ────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Docker ──────────────────────────────────────────────────────
# Don't ignore docker files — they should be committed
# But ignore local override files
docker-compose.override.yml

# ── Node (if you add a React frontend later) ─────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn/

# ── Misc ────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
.flashrank_cache/
.apollo_cache/
